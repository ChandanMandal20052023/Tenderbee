# ==============================================================================
# TenderBee Environment Configuration Template (.env.example)
# All secrets must be populated in .env. Never commit actual secrets or tokens.
# ==============================================================================

# 1. Django Application Core & Production Security
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.tenderbee.in,api.tenderbee.in
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.tenderbee.in
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# 2. Neon Serverless PostgreSQL (sslmode=require mandatory)
# DATABASE_URL: Pooled connection string used for app runtime
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/tenderbee?sslmode=require
# DIRECT_URL: Direct session connection string used for migrations
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/tenderbee?sslmode=require

# 3. Redis & Celery
REDIS_URL=redis://localhost:6379/0

# 4. JWT Lifetimes & Security
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# 5. Object Storage Configuration
# Options: disk (secure server-side storage), b2 (Backblaze B2 10GB free tier), r2 (Cloudflare R2), or catalyst
STORAGE_BACKEND=disk
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_APPLICATION_KEY_ID=your_backblaze_keyID
B2_APPLICATION_KEY=your_backblaze_applicationKey
B2_BUCKET_NAME=your_b2_bucket_name
B2_REGION=us-west-004

# Cloudflare R2
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=tenderbee

# Zoho Catalyst
CATALYST_PROJECT_ID=your_catalyst_project_id_here
CATALYST_ENVIRONMENT=Development
CATALYST_CLIENT_ID=your_catalyst_client_id_here
CATALYST_CLIENT_SECRET=your_catalyst_client_secret_here
CATALYST_FOLDER_ID=your_catalyst_private_folder_id_here

# 6. Next.js Frontend & Same-Origin Proxy Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/backend
INTERNAL_BACKEND_URL=http://127.0.0.1:8000
NODE_ENV=production

# 7. External Registry & LLM Integrations
TINYFISH_API_KEY=your_tinyfish_api_key_here
LLM_API_KEY=your_llm_api_key_here
