# Neon serverless PostgreSQL connection strings (sslmode=require mandatory)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/tenderbee?sslmode=require
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/tenderbee?sslmode=require

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# Object Storage (S3-compatible)
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=sample_access_key
S3_SECRET_ACCESS_KEY=sample_secret_key
S3_BUCKET_NAME=tenderbee

# External Integrations & LLM
TINYFISH_API_KEY=sample_tinyfish_api_key
LLM_API_KEY=sample_llm_api_key
