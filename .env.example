# ==============================================================================
# TenderBee Environment Configuration Template
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# 1. TinyFish API (For Infralens / Tender Scraping & Agent)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# 2. Database Configuration (PostgreSQL in Production, SQLite in Dev)
# In development, leave empty to use built-in SQLite: data/tenderbee.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenderbee

# 3. Object Storage (AWS S3 / MinIO / Local Disk)
# Set to 's3' in production or 'local' in development
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=tenderbee-snapshots
AWS_S3_REGION_NAME=ap-south-1

# 4. LLM API (For Extraction & Rule Drafting)
GEMINI_API_KEY=
