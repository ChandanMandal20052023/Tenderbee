# ==============================================================================
# TenderBee Environment Configuration Template
# ==============================================================================

# 1. Neon Serverless PostgreSQL (sslmode=require mandatory)
# DATABASE_URL: Pooled connection string used for app runtime
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/tenderbee?sslmode=require
# DIRECT_URL: Direct session connection string used for migrations
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/tenderbee?sslmode=require

# 2. Redis & Celery
REDIS_URL=redis://redis:6379/0

# 3. Object Storage: Backblaze B2 (10GB Free Tier) or Cloudflare R2
STORAGE_BACKEND=b2
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_APPLICATION_KEY_ID=your_backblaze_keyID
B2_APPLICATION_KEY=your_backblaze_applicationKey
B2_BUCKET_NAME=your_b2_bucket_name
B2_REGION=us-west-004

# Cloudflare R2 (Alternative 10GB Free Tier)
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=tenderbee

# 4. External Integrations & LLM
TINYFISH_API_KEY=your_tinyfish_api_key_here
LLM_API_KEY=sample_llm_api_key
GEMINI_API_KEY=
